# Copy to .env.local. All values are server-only.

# Deepgram key for voice (STT token + TTS proxy). Voice falls back to browser speech when unset.
DEEPGRAM_API_KEY=

# HMAC secret for the login session cookie. Required in production (16+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Required 6-digit view-only access code for the login page. Login is refused while unset.
DASHBOARD_ACCESS_CODE=123456

# go2rtc player page for the CCTV window (embedded in an iframe; its origin is added to the CSP frame-src at build time).
# Use https when the dashboard is served over https. Example: https://cctv.example.com/stream.html?src=camera1&mode=webrtc,mse
CCTV_STREAM_URL=
